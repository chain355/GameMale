<?xml version="1.0" encoding="utf-8"?>
<!-- 安全模式界面：不依赖 Compose / COUI，保证任何情况下都能看帖 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F1F2"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/safe_back"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="#1B1C1E"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/safe_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Gamemale"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1B1C1E" />

        <TextView
            android:id="@+id/safe_refresh"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="↻"
            android:textSize="19sp"
            android:textColor="#1B1C1E"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/safe_menu"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⋮"
            android:textSize="19sp"
            android:textColor="#1B1C1E"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <TextView
        android:id="@+id/safe_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF4D6"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="上次启动闪退了，当前是安全模式 · 点这里查看日志、重试美化界面"
        android:textSize="12sp"
        android:textColor="#8A5A00" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
